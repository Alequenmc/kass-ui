{
  "name": "@kass-ui/library",
  "version": "0.1.0",
  "description": "A modern, minimalist React component library — composable, accessible, and type-safe.",
  "license": "MIT",
  "author": "Alex",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alequenmc/kass-ui"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./accordion": {
      "types": "./dist/components/accordion/index.d.ts",
      "import": "./dist/components/accordion/index.js",
      "require": "./dist/components/accordion/index.cjs"
    },
    "./alert-dialog": {
      "types": "./dist/components/alert-dialog/index.d.ts",
      "import": "./dist/components/alert-dialog/index.js",
      "require": "./dist/components/alert-dialog/index.cjs"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.js",
      "require": "./dist/components/badge/index.cjs"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.js",
      "require": "./dist/components/button/index.cjs"
    },
    "./card": {
      "types": "./dist/components/card/index.d.ts",
      "import": "./dist/components/card/index.js",
      "require": "./dist/components/card/index.cjs"
    },
    "./checkbox": {
      "types": "./dist/components/checkbox/index.d.ts",
      "import": "./dist/components/checkbox/index.js",
      "require": "./dist/components/checkbox/index.cjs"
    },
    "./dialog": {
      "types": "./dist/components/dialog/index.d.ts",
      "import": "./dist/components/dialog/index.js",
      "require": "./dist/components/dialog/index.cjs"
    },
    "./dropdown-menu": {
      "types": "./dist/components/dropdown-menu/index.d.ts",
      "import": "./dist/components/dropdown-menu/index.js",
      "require": "./dist/components/dropdown-menu/index.cjs"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/components/input/index.js",
      "require": "./dist/components/input/index.cjs"
    },
    "./label": {
      "types": "./dist/components/label/index.d.ts",
      "import": "./dist/components/label/index.js",
      "require": "./dist/components/label/index.cjs"
    },
    "./popover": {
      "types": "./dist/components/popover/index.d.ts",
      "import": "./dist/components/popover/index.js",
      "require": "./dist/components/popover/index.cjs"
    },
    "./select": {
      "types": "./dist/components/select/index.d.ts",
      "import": "./dist/components/select/index.js",
      "require": "./dist/components/select/index.cjs"
    },
    "./separator": {
      "types": "./dist/components/separator/index.d.ts",
      "import": "./dist/components/separator/index.js",
      "require": "./dist/components/separator/index.cjs"
    },
    "./skeleton": {
      "types": "./dist/components/skeleton/index.d.ts",
      "import": "./dist/components/skeleton/index.js",
      "require": "./dist/components/skeleton/index.cjs"
    },
    "./spinner": {
      "types": "./dist/components/spinner/index.d.ts",
      "import": "./dist/components/spinner/index.js",
      "require": "./dist/components/spinner/index.cjs"
    },
    "./switch": {
      "types": "./dist/components/switch/index.d.ts",
      "import": "./dist/components/switch/index.js",
      "require": "./dist/components/switch/index.cjs"
    },
    "./tabs": {
      "types": "./dist/components/tabs/index.d.ts",
      "import": "./dist/components/tabs/index.js",
      "require": "./dist/components/tabs/index.cjs"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/components/textarea/index.js",
      "require": "./dist/components/textarea/index.cjs"
    },
    "./tooltip": {
      "types": "./dist/components/tooltip/index.d.ts",
      "import": "./dist/components/tooltip/index.js",
      "require": "./dist/components/tooltip/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm build:js && pnpm build:css",
    "build:js": "tsup",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/index.css -o ./dist/styles.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rimraf dist coverage .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.28.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
